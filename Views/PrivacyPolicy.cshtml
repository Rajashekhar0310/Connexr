@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.PrivacyPolicy>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    Layout = "master.cshtml";  // change to your site's master layout
}
@*
    ============================================================================
    Privacy Policy  —  page template (NOT a block)
    ----------------------------------------------------------------------------
    Save as: Views/privacyPolicy.cshtml

    Document type: privacyPolicy   (allow it under Home, or wherever policies live)
        pageTitle        Textstring        "Privacy Policy"
        introText        Textarea          the bold summary line under the title
        lastUpdated      Date Picker        shown under the "LAST UPDATED" label
        bodyContent      Rich Text Editor   the whole policy body
        contactHeading   Textstring        "Contact Us"
        contactText      Textstring        line above the button
        contactButtonText Textstring       button label, e.g. "Info@Connexr.Com"
        contactEmail     Textstring        address the button links to

    The Rich Text Editor output is styled by .policy__body below, so editors just
    write H2 / H3 / bullet lists normally and they pick up the design. For the
    two-tone orange+navy headings, editors wrap the navy half in a <span>:
        Information <span>We Collect</span>
    ============================================================================
*@
@{
    var pageTitle    = Model.Value<string>("pageTitle");
    if (string.IsNullOrWhiteSpace(pageTitle)) { pageTitle = Model.Name; }

    var introText    = Model.Value<string>("introText");
var lastUpdated  = Model.Value<DateTime>("lastUpdated");
        var bodyContent  = Model.Value("bodyContent");
    var contactHeading    = Model.Value<string>("contactHeading");
    var contactText       = Model.Value<string>("contactText");
    var contactButtonText = Model.Value<string>("contactButtonText");
    var contactEmail      = Model.Value<string>("contactEmail");
}

<style>
    :root{
        --navy:#12245e;
        --navy-soft:#1e3a70;
        --orange:#f58a3c;
        --body:#3f4a63;
        --cream:#FFF4EB;
        --line:#c9d2e6;
      }

      *{box-sizing:border-box;margin:0;padding:0}

      body{
        font-family:'Poppins',system-ui,-apple-system,"Segoe UI",sans-serif;
        color:var(--body);
        background:var(--cream);
        -webkit-font-smoothing:antialiased;
        line-height:1.6;
      }

      /* soft peach page, faint dot pairs floating in the side margins */
      .policy{
        position:relative;
        padding:56px 20px 110px;
        overflow:hidden;
      }

      .policy__dots{
        position:absolute;
        display:flex;
        gap:9px;
        z-index:0;
      }
      .policy__dots i{width:8px;height:8px;border-radius:50%;background:var(--orange);opacity:.85}
      .policy__dots--left{top:360px;left:6%}
      .policy__dots--right{top:360px;right:6%}

      .policy__inner{
        position:relative;
        z-index:1;
        max-width:740px;
        margin:0 auto;
        margin-top:100px;
      }

      /* ---------- breadcrumb ---------- */
      .policy__crumbs{
        font-size:10px;
        font-weight:600;
        letter-spacing:1.2px;
        text-transform:uppercase;
        color:var(--navy);
        opacity:.75;
        margin-bottom:44px;
      }
      .policy__crumbs a{color:inherit;text-decoration:none}
      .policy__crumbs a:hover{color:var(--orange)}
      .policy__crumbs span{margin:0 6px;opacity:.6}

      /* ---------- masthead ---------- */
      .policy__title{
        color:var(--navy);
        font-size:clamp(38px,5vw,52px);
        font-weight:700;
        letter-spacing:-.02em;
        line-height:1.1;
        margin-bottom:22px;
      }

      .policy__intro{
        color:var(--navy);
        font-size:clamp(17px,1.6vw,19px);
        font-weight:600;
        line-height:1.5;
        max-width:52ch;
        margin-bottom:40px;
      }

      .policy__meta-label{
        color:var(--orange);
        font-size:11px;
        font-weight:700;
        letter-spacing:1.4px;
        text-transform:uppercase;
        margin-bottom:6px;
      }
      .policy__meta-date{
        color:var(--navy);
        font-size:14px;
        font-weight:600;
      }

      .policy__rule{
        height:1px;
        background:#122560;
        border:0;
        margin:30px 0 60px;
      }

      /* ---------- body sections ---------- */
      .policy__section{margin-bottom:44px}

      .policy__h2{
        font-size:clamp(22px,2.4vw,27px);
        font-weight:700;
        letter-spacing:-.01em;
        color:var(--orange);
        margin-bottom:16px;
      }
      /* the second half of a two-tone heading */
      .policy__h2 .navy{color:var(--navy)}

      .policy__h3{
        font-size:18px;
        font-weight:600;
        color:var(--navy);
        margin:26px 0 12px;
      }

      .policy__section p{
        font-size:14.5px;
        line-height:1.75;
        color:var(--body);
        margin-bottom:14px;
        max-width:66ch;
      }

      .policy__list{
        list-style:none;
        margin:0 0 14px;
        padding:0;
        max-width:66ch;
      }
      .policy__list li{
        position:relative;
        padding-left:20px;
        font-size:14.5px;
        line-height:1.9;
        color:var(--body);
      }
      .policy__list li::before{
        content:"";
        position:absolute;
        left:4px;
        top:.82em;
        width:5px;height:5px;
        border-radius:50%;
        background:var(--navy);
      }

      .policy__section a{color:var(--navy-soft);text-decoration:underline;text-underline-offset:2px}
      .policy__section a:hover{color:var(--orange)}

      /* contact block: soft peach panel, orange button with arrow */
      .policy__contact{
        margin-top:6px;
        padding:34px 40px 40px;
        background:#fae6d4;
        border-radius:2px;
      }
      .policy__contact .policy__h2{margin-bottom:14px}
      .policy__contact p{
        margin:0 0 22px;
        font-size:14.5px;
        color:var(--body);
      }
      .policy__contact-btn{
        display:inline-flex;
        align-items:center;
        gap:14px;
        padding:12px 20px;
        background:var(--orange);
        color:#fff;
        font-size:13.5px;
        font-weight:500;
        text-decoration:none;
        border-radius:2px;
        transition:background .3s ease, transform .3s ease;
      }
      .policy__contact-btn:hover{background:#e97a2c;transform:translateY(-1px)}
      .policy__contact-btn svg{width:17px;height:17px}

      /* ---------- responsive ---------- */
      @@media (max-width:820px){
        .policy__dots{display:none}
      }
      @@media (max-width:560px){
        .policy{padding:48px 18px 70px}
        .policy__crumbs{margin-bottom:32px}
        .policy__intro{max-width:none}
      }
        /* ---------- Rich Text Editor body: map bare tags to the design ---------- */
        .policy__body{margin-bottom:44px}

        .policy__body h2{
            font-size:clamp(22px,2.4vw,27px);
            font-weight:700;letter-spacing:-.01em;
            color:var(--orange);
            margin:44px 0 16px;
        }
        .policy__body h2:first-child{margin-top:0}
        /* editors wrap the navy half of a heading in a <span> */
        .policy__body h2 span{color:var(--navy)}

        .policy__body h3{
            font-size:18px;font-weight:600;color:var(--navy);
            margin:26px 0 12px;
        }

        .policy__body p{
            font-size:14.5px;line-height:1.75;color:var(--body);
            margin-bottom:14px;max-width:66ch;
        }

        .policy__body ul{list-style:none;margin:0 0 14px;padding:0;max-width:66ch}
        .policy__body ul li{
            position:relative;padding-left:20px;
            font-size:14.5px;line-height:1.9;color:var(--body);
        }
        .policy__body ul li::before{
            content:"";position:absolute;left:4px;top:.82em;
            width:5px;height:5px;border-radius:50%;background:var(--navy);
        }

        .policy__body a{color:var(--navy-soft);text-decoration:underline;text-underline-offset:2px}
        .policy__body a:hover{color:var(--orange)}
        .policy__body strong{color:var(--navy);font-weight:600}

    </style>

<main class="policy">

  <span class="policy__dots policy__dots--left" aria-hidden="true"><i></i><i></i></span>
  <span class="policy__dots policy__dots--right" aria-hidden="true"><i></i><i></i></span>

  <div class="policy__inner">

    <h1 class="policy__title">@pageTitle</h1>

    @if (!string.IsNullOrWhiteSpace(introText))
    {
        <p class="policy__intro">@introText</p>
    }

@if (lastUpdated > DateTime.MinValue)
{
    <p class="policy__meta-label">Last updated</p>
    <p class="policy__meta-date">@lastUpdated.ToString("MMMM yyyy")</p>
}

    <hr class="policy__rule">

    @if (bodyContent != null)
    {
        <div class="policy__body">
            @bodyContent
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(contactEmail) || !string.IsNullOrWhiteSpace(contactHeading))
    {
        <section class="policy__section">
          <div class="policy__contact">
            @if (!string.IsNullOrWhiteSpace(contactHeading))
            {
                <h2 class="policy__h2">@contactHeading</h2>
            }
            @if (!string.IsNullOrWhiteSpace(contactText))
            {
                <p>@contactText</p>
            }
            @if (!string.IsNullOrWhiteSpace(contactEmail))
            {
                <a class="policy__contact-btn" href="mailto:@contactEmail">
                  @(string.IsNullOrWhiteSpace(contactButtonText) ? contactEmail : contactButtonText)
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h13M13 6l6 6-6 6"/>
                  </svg>
                </a>
            }
          </div>
        </section>
    }

  </div>
</main>
