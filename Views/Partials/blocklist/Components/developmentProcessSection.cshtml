@using System.Text.Json
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>

@{
    var content = Model.Content;

    var sectionLabel = content.Value<string>("sectionLabel");
    var sectionHeading = content.Value<string>("sectionHeading");

    var processSteps = content.Value<BlockListModel>("steps");

    var processData = new List<object>();

    if (processSteps != null)
    {
        foreach (var item in processSteps)
        {
            var step = item.Content;

            var image = step.Value<MediaWithCrops>("developImage");
            var icon = step.Value<MediaWithCrops>("icon");

            processData.Add(new
            {
                title = step.Value<string>("title"),
                description1 = step.Value<string>("description1"),
                description2 = step.Value<string>("description2"),
                image = image?.MediaUrl(),
                icon = icon?.MediaUrl()
            });
        }
    }

    var json = JsonSerializer.Serialize(processData);

    var firstStep = processSteps?.FirstOrDefault()?.Content;

    var firstTitle = "";
    var firstDescription1 = "";
    var firstDescription2 = "";

    MediaWithCrops? firstImage = null;
    MediaWithCrops? firstIcon = null;

    if (firstStep != null)
    {
        firstTitle = firstStep.Value<string>("title") ?? "";
        firstDescription1 = firstStep.Value<string>("description1") ?? "";
        firstDescription2 = firstStep.Value<string>("description2") ?? "";

        firstImage = firstStep.Value<MediaWithCrops>("developImage");
        firstIcon = firstStep.Value<MediaWithCrops>("icon");
    }
}

<section class="process" id="process">

    <script id="processData" type="application/json">
        @Html.Raw(json)
    </script>

    <div class="sticky">

        <!-- Heading -->

        <div class="head">

            <div class="twodots">
                <i></i>
                <i></i>
            </div>

            <b>@sectionHeading</b>

        </div>

        <div class="layout">

            <!-- LEFT -->

            <div class="left">

                <!-- <div class="big-num" id="bigNum">
                    01
                </div> -->

                <div class="copy">

                    <div class="bg-icon">

                        @if (firstIcon != null)
                        {
                            <img id="processIcon"
                                 src="@firstIcon.MediaUrl()"
                                 alt="Icon" />
                        }

                    </div>

                    <h2 id="title">
                        @firstTitle
                    </h2>

                    <div id="desc">

                        <p>@firstDescription1</p>

                        <p>@firstDescription2</p>

                    </div>

                </div>

                <div class="steps" id="steps">

                    @if (processSteps != null)
                    {
                        for (int i = 0; i < processSteps.Count; i++)
                        {
                            <span class="@(i == 0 ? "active" : "")">
                                @((i + 1).ToString("D2"))
                            </span>
                        }
                    }

                </div>

                <div class="arrows">

                    <button id="prev" type="button">
                        ←
                    </button>

                    <button id="next" type="button">
                        →
                    </button>

                </div>

            </div>
                        <!-- RIGHT -->

            <div class="right">

                <div class="scene">

                    <svg class="path" viewBox="0 0 100 100">

                        <circle class="track"
                                cx="50"
                                cy="50"
                                r="37" />

                        <circle id="connect"
                                class="link"
                                pathLength="100"
                                cx="50"
                                cy="50"
                                r="37"
                                transform="rotate(-87.6 50 50)">
                        </circle>

                        <circle class="dot" cx="51.55" cy="13.61" r="2.3" />
                        <circle class="dot" cx="87.75" cy="49.05" r="2.3" />
                        <circle class="dot orange" cx="78.90" cy="72.16" r="2.3" />
                        <circle class="dot" cx="13.03" cy="47.13" r="2.3" />
                        <circle class="dot orange" cx="21.50" cy="25.94" r="2.3" />

                    </svg>

                    <div class="orange"></div>

                    <div class="photo">

                        @if (processSteps != null)
                        {
                            var index = 0;

                            foreach (var item in processSteps)
                            {
                                var step = item.Content;

                                var img = step.Value<MediaWithCrops>("developImage");

                                var imgTitle = step.Value<string>("title");

                                if (img != null)
                                {
                                    <img class="@(index == 0 ? "active" : "")"
                                         src="@img.MediaUrl()"
                                         alt="@imgTitle" />

                                    index++;
                                }
                            }
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<script src="/Scripts/Custom Ai Solutions/development-process.js"></script>
