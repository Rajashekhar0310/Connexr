@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>

@{
    var content = Model.Content;

    var smallHeading = content.Value<string>("smallHeading");
    var headingOrange = content.Value<string>("headingOrange");
    var headingWhite = content.Value<string>("headingBlue");

    var backgroundImage = content.Value<MediaWithCrops>("backgroundImage");

    var cards = content.Value<BlockListModel>("cards");
}

<section class="custom-ai-why-section"
         style="background-image:url('@backgroundImage?.MediaUrl()');">

    <div class="custom-ai-why-overlay"></div>

    <div class="custom-ai-why-container">

        <!-- Heading -->

        <div class="custom-ai-why-heading">

            <div class="custom-ai-why-heading-top">

                <span class="custom-ai-why-dot"></span>
                <span class="custom-ai-why-dot"></span>

                @if (!string.IsNullOrWhiteSpace(smallHeading))
                {
                    <span class="custom-ai-why-subtitle">
                        @smallHeading
                    </span>
                }

            </div>

            <h2 class="custom-ai-why-title">

                @if (!string.IsNullOrWhiteSpace(headingOrange))
                {
                    <span class="custom-ai-why-orange">
                        @headingOrange
                    </span>

                    <br />
                }

                @if (!string.IsNullOrWhiteSpace(headingWhite))
                {
                    <span class="custom-ai-why-white">
                        @headingWhite
                    </span>
                }

            </h2>

        </div>

        <!-- Cards -->

        <div class="custom-ai-why-grid">

            @if (cards != null && cards.Any())
            {
                foreach (var item in cards)
                {
                    var card = item.Content;

                    var cardType = card.Value<string>("cardType");

                    var title = card.Value<string>("title");

                    var description = card.Value<string>("description");

                    var buttonText = card.Value<string>("buttonText");
var buttonLink = card.Value<IEnumerable<Link>>("buttonLink")?.FirstOrDefault();
                    <!-- var buttonLink = card.Value<Link>("buttonLink"); -->

                    string cssClass = "custom-ai-why-glass";

                    if (!string.IsNullOrWhiteSpace(cardType) &&
                        cardType.Equals("CTA", StringComparison.OrdinalIgnoreCase))
                    {
                        cssClass = "custom-ai-why-cta";
                    }

                    <div class="custom-ai-why-card @cssClass">

                        <div class="custom-ai-why-card-content">

                            @if (!string.IsNullOrWhiteSpace(title))
                            {
                                <h3>@title</h3>
                            }

                            @if (!string.IsNullOrWhiteSpace(description))
                            {
                                <p>@description</p>
                            }

                           @if (cssClass == "custom-ai-why-cta")
                            {
                                <a href="@buttonLink?.Url"
   target="@buttonLink?.Target"
   class="custom-ai-why-btn">

    <span>@buttonText</span>

    <svg width="18"
         height="18"
         viewBox="0 0 24 24"
         fill="none">
        <path d="M7 17L17 7"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round" />
        <path d="M8 7H17V16"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round" />
    </svg>

</a>
                            }

                        </div>

                    </div>
                }
            }

        </div>

    </div>

</section>