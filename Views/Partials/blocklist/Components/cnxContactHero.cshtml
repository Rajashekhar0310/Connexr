@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>
@*
    ============================================================================
    CNX Contact Hero  —  markup + Jotform embed (CSS is in cnx-contact-hero.css)
    ----------------------------------------------------------------------------
    Save as: Views/Partials/blocklist/Components/cnxContactHero.cshtml
             (file name must match the element type alias exactly)

    Element type: cnxContactHero
        heroScene       Media Picker   single, images only (the skyline photo)
        heroSceneAlt    Textstring     describes the photo
        heroTitleLine1  Textstring     "Let's Start"
        heroTitleLine2  Textstring     "a Conversation"
        heroLead        Textarea       intro paragraph under the title
        heroEmail       Textstring     info@connexr.com
        heroPhone       Textstring     469-927-3307
        heroJotformId   Textstring     262034660678057  (just the id, not the URL)
        heroOffices     Block List     blocks of type cnxOffice

    Element type: cnxOffice
        officeTitle     Textstring (mandatory)
        officeLine1     Textstring
        officeLine2     Textstring
        officeLine3     Textstring     optional third line

    Every office card behaves the same: frosted glass at rest, solid white on
    hover / focus. No "primary" card.
    ============================================================================
*@
@{
    var hero = Model.Content;

    var scene    = hero.Value<MediaWithCrops>("sceneImage");
    var sceneAlt = hero.Value<string>("heroSceneAlt");
    var sceneUrl = scene?.GetCropUrl(width: 2000, height: 1100, imageCropMode: ImageCropMode.Crop);

    var titleLine1 = hero.Value<string>("heroTitleLine1");
    var titleLine2 = hero.Value<string>("heroTitleLine2");
    var lead       = hero.Value<string>("heroLead");

    var contactEmail = hero.Value<string>("heroEmail");
    var contactPhone = hero.Value<string>("heroPhone");
    var jotformId    = hero.Value<string>("heroJotformId");

    // strip anything that is not a digit, so editors can paste the full URL if they like
    var jotformDigits = new string((jotformId ?? "").Where(char.IsDigit).ToArray());

    // tel: link wants digits only, keep a leading + if present
    var telHref = "+" + new string((contactPhone ?? "").Where(char.IsDigit).ToArray());

    var offices = hero.Value<BlockListModel>("heroOffices")?.ToList() ?? new List<BlockListItem>();

}



<section class="contact-hero">

    @if (!string.IsNullOrWhiteSpace(sceneUrl))
    {
        <div class="contact-hero__scene" style="background-image:url('@sceneUrl')" role="img" aria-label="@sceneAlt"></div>
    }
    else
    {
        <div class="contact-hero__scene" aria-hidden="true"></div>
    }

    <div class="contact-hero__veil"></div>

    <div class="contact-hero__wrap">

        <div>
          

            <h1 class="contact-hero__title">
                @titleLine1@if (!string.IsNullOrWhiteSpace(titleLine2)) {<br />@titleLine2}
            </h1>

            @if (!string.IsNullOrWhiteSpace(lead))
            {
                <p class="contact-hero__lead">@Html.Raw(lead.Replace("\n", "<br />"))</p>
            }

            @if (offices.Any())
            {
                <div class="offices">
                    @foreach (var block in offices)
                    {
                        var office = block.Content;
                        var name = office.Value<string>("officeName");
                        var l1   = office.Value<string>("addressLine1");
                        var l2   = office.Value<string>("addressLine2");
                        var l3   = office.Value<string>("addressLine3");

                        <article class="office" tabindex="0">
                            <svg class="office__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21V6l7-3 7 3v15"/><path d="M2 21h20"/><path d="M8 10h2M14 10h2M8 14h2M14 14h2M8 18h2M14 18h2"/></svg>
                            <h3 class="office__name">@name</h3>
                            <p class="office__address">
                                @l1@if (!string.IsNullOrWhiteSpace(l2)) {<br />@l2}@if (!string.IsNullOrWhiteSpace(l3)) {<br />@l3}
                            </p>
                            <div class="office__dots" aria-hidden="true"><i></i><i></i></div>
                        </article>
                    }
                </div>
            }
        </div>

        <aside class="contact-panel">

            <div class="contact-panel__bar">
                @if (!string.IsNullOrWhiteSpace(contactEmail))
                {
                    <a class="contact-panel__link" href="mailto:@contactEmail">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                        @contactEmail
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(contactPhone))
                {
                    <a class="contact-panel__link" href="tel:@telHref">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
                        @contactPhone
                    </a>
                }
            </div>

            <div class="contact-panel__form">
                @if (!string.IsNullOrWhiteSpace(jotformDigits))
                {
                    <iframe id="JotFormIFrame-@jotformDigits"
                            title="Contact form"
                            onload="window.parent.scrollTo(0,0)"
                            allowtransparency="true"
                            allow="geolocation; microphone; camera; fullscreen; payment"
                            src="https://form.jotform.com/@jotformDigits"
                            frameborder="0"
                            style="min-width:100%;max-width:100%;height:1400px;border:none;"
                            scrolling="no"></iframe>
                }
            </div>

        </aside>

    </div>

    <div class="contact-hero__spacer"></div>
</section>

@*
    The Jotform auto-resize handler is intentionally NOT included here.
    We give the iframe a fixed height and let the white panel scroll internally
    (see .contact-panel__form), so a long form no longer stretches the section.
    If you prefer the form to expand to full height instead, delete the
    max-height/overflow on .contact-panel__form and re-add the handler:

    <script src="https://cdn.jotfor.ms/s/umd/latest/for-form-embed-handler.js"></script>
    <script>window.jotformEmbedHandler("iframe[id='JotFormIFrame-@jotformDigits']", "https://form.jotform.com/")</script>
*@
