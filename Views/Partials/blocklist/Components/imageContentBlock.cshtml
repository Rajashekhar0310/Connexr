@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Extensions

@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>

@{
    var title = Model.Content.Value<string>("title");
    var content = Model.Content.Value<string>("content");

    var bgImage = Model.Content.Value<MediaWithCrops>("ctaimage");
    var video = Model.Content.Value<MediaWithCrops>("video");

    var imagePosition = Model.Content.Value<string>("imagePosition") ?? "Left";
     var ctaText = Model.Content.Value<string>("buttonText");
    var links = Model.Content.Value<IEnumerable<Link>>("buttonLink");
}
<section class="image-content-section @(imagePosition.ToLower())">

    @if (bgImage != null)
    {
        <img class="image-content-bg"
             src="@bgImage.Url()"
             alt="@title" />
    }

    @if (video != null)
    {
        <video class="image-content-video" autoplay muted loop playsinline>
            <source src="@video.Url()" type="video/mp4" />
        </video>
    }

    <div class="image-content-overlay"></div>

    <div class="image-content-wrapper">

        <div class="image-content-details">

            @if (!string.IsNullOrWhiteSpace(title))
            {
                <h2 class="image-content-title">
                    @title
                </h2>
            }

            @if (!string.IsNullOrWhiteSpace(content))
            {
                <div class="image-content-description">
                    @Html.Raw(content)
                </div>
            }

            @if (links != null)
            {
                foreach (var item in links)
                {
                    <a href="@item.Url"
                       target="@item.Target"
                       class="image-content-button">

                        <!-- @item.Name -->

                        <span>@ctaText </span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                <path d="M7 17L17 7M17 7H9M17 7V15"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"/>
                            </svg>

                    </a>
                    

                }
            }

        </div>

    </div>

</section>