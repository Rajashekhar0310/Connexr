@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Extensions

@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>

@{
    var content = Model.Content;

    var eyebrowText = content.Value<string>("eyebrowText") ?? "";
    var heading = content.Value<string>("heading") ?? "";
    var highlightText = content.Value<string>("highlightText") ?? "";
    var description = content.Value<string>("description") ?? "";
    var buttonText = content.Value<string>("buttonText") ?? "";
    var buttonLink = content.Value<IEnumerable<Link>>("buttonLink")?.FirstOrDefault();

    var partners = content.Value<BlockListModel>("partnerLogos");

    var partnerList = partners?.ToList() ?? new List<BlockListItem>();

    var firstRow = partnerList.Take(3).ToList();

    var secondRow = partnerList.Skip(3).Take(3).ToList();
}

<section class="ps-section">

    <div class="container">

        <div class="ps-inner">

            <!-- ================= Left Content ================= -->

            <div class="ps-text">

                @if (!string.IsNullOrWhiteSpace(eyebrowText))
                {
                    <p class="ps-eyebrow">@eyebrowText</p>
                }

                <h2 class="ps-heading">

                    <span class="ps-heading__main">
                        @heading
                    </span>

                    <span class="ps-heading__highlight">
                        @highlightText
                    </span>

                </h2>

                @if (!string.IsNullOrWhiteSpace(description))
                {
                    <div class="ps-description">

                        @Html.Raw(description)

                    </div>
                }

                @if (buttonLink != null)
                {
                    <a href="@buttonLink.Url"
                       target="@(string.IsNullOrWhiteSpace(buttonLink.Target) ? "_self" : buttonLink.Target)"
                       class="ps-btn">

                        <span>@buttonText</span>

                        <svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none">

                            <path
                                d="M5 12H19M19 12L13 6M19 12L13 18"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"/>

                        </svg>

                    </a>
                }

            </div>

            <!-- ================= Right Logos ================= -->

            <div class="ps-logos-wrapper">

                <!-- ================= ROW 1 ================= -->

                <div class="ps-row ps-row-one">

                    <div class="ps-track">

                        @foreach (var block in firstRow.Concat(firstRow))
                        {
                            var logo = block.Content.Value<IPublishedContent>("partnerLogo");
                            var bgColor = block.Content.Value<string>("backgroundColor") ?? "#fff";

                            <div class="ps-card"
                                 style="background:@bgColor;">

                                @if (logo != null)
                                {
                                    <img src="@logo.Url()"
                                         alt="@logo.Name"
                                         loading="lazy" />
                                }

                            </div>
                        }

                    </div>

                </div>

                <!-- ================= ROW 2 ================= -->

                <div class="ps-row ps-row-two">

                    <div class="ps-track">

                        @foreach (var block in secondRow.Concat(secondRow))
                        {
                            var logo = block.Content.Value<IPublishedContent>("partnerLogo");
                            var bgColor = block.Content.Value<string>("backgroundColor") ?? "#fff";

                            <div class="ps-card"
                                 style="background:@bgColor;">

                                @if (logo != null)
                                {
                                    <img src="@logo.Url()"
                                         alt="@logo.Name"
                                         loading="lazy" />
                                }

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
<script>
    document.addEventListener("DOMContentLoaded", function () {

    // Row 1: Right → Left
    marqueeLeft(".ps-row-one .ps-track", 45);

    // Row 2: Left → Right
    marqueeRight(".ps-row-two .ps-track", 45);

});

function marqueeLeft(selector, speed) {

    const track = document.querySelector(selector);

    if (!track) return;

    const distance = track.scrollWidth / 2;

    gsap.set(track, {
        x: 0
    });

    gsap.to(track, {
        x: -distance,
        duration: speed,
        ease: "none",
        repeat: -1,
        modifiers: {
            x: gsap.utils.unitize(x => parseFloat(x) % distance)
        }
    });

}

function marqueeRight(selector, speed) {

    const track = document.querySelector(selector);

    if (!track) return;

    const distance = track.scrollWidth / 2;

    gsap.set(track, {
        x: -distance
    });

    gsap.to(track, {
        x: 0,
        duration: speed,
        ease: "none",
        repeat: -1,
        modifiers: {
            x: gsap.utils.unitize(x => {
                let value = parseFloat(x);
                return ((value + distance) % distance) - distance;
            })
        }
    });

}
</script>