@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Extensions

@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>

@{
    var content = Model.Content;

    var eyebrowText = content.Value<string>("eyebrowText") ?? "";
    var heading = content.Value<string>("heading") ?? "";
    var highlightText = content.Value<string>("highlightText") ?? "";
    var description = content.Value<string>("description") ?? "";
    var buttonText = content.Value<string>("buttonText") ?? "";
    var buttonLink = content.Value<IEnumerable<Link>>("buttonLink")?.FirstOrDefault();

    var partners = content.Value<BlockListModel>("partnerLogos");

    // drop any block that has no image picked
    var partnerList = partners?
        .Where(b => b.Content.Value<IPublishedContent>("partnerLogo") != null)
        .ToList() ?? new List<BlockListItem>();

    // split evenly so nothing is dropped, whatever the count
    var half = (int)Math.Ceiling(partnerList.Count / 2.0);
    var firstRow = partnerList.Take(half).ToList();
    var secondRow = partnerList.Skip(half).ToList();

    // unique id per block instance so multiple blocks on one page do not clash
    var uid = "cxp-" + Guid.NewGuid().ToString("N").Substring(0, 8);
}

<section class="cxp-section" id="@uid">

    <div class="cxp-inner">

        <!-- ================= Left Content ================= -->

        <div class="cxp-text">

            @if (!string.IsNullOrWhiteSpace(eyebrowText))
            {
                <p class="cxp-eyebrow">@eyebrowText</p>
            }

            <h2 class="cxp-heading">

                <span class="cxp-heading-main">
                    @heading
                </span>

                <span class="cxp-heading-highlight">
                    @highlightText
                </span>

            </h2>

            @if (!string.IsNullOrWhiteSpace(description))
            {
                <div class="cxp-description">
                    @Html.Raw(description)
                </div>
            }

            @if (buttonLink != null)
            {
                <a href="@buttonLink.Url"
                   target="@(string.IsNullOrWhiteSpace(buttonLink.Target) ? "_self" : buttonLink.Target)"
                   class="cxp-btn">

                    <span>@buttonText</span>

                    <svg width="18"
                         height="18"
                         viewBox="0 0 24 24"
                         fill="none">
                        <path d="M5 12H19M19 12L13 6M19 12L13 18"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round" />
                    </svg>

                </a>
            }

        </div>

        <!-- ================= Right Logos ================= -->

        <div class="cxp-logos">

            <!-- ROW 1 : right to left -->
            <div class="cxp-row cxp-row-one">
                <div class="cxp-track">

                    @foreach (var block in firstRow.Concat(firstRow))
                    {
                        var logo = block.Content.Value<IPublishedContent>("partnerLogo");

                        <div class="cxp-card">
                            <img src="@logo.Url()"
                                 alt="@logo.Name" />
                        </div>
                    }

                </div>
            </div>

            <!-- ROW 2 : left to right -->
            <div class="cxp-row cxp-row-two">
                <div class="cxp-track">

                    @foreach (var block in secondRow.Concat(secondRow))
                    {
                        var logo = block.Content.Value<IPublishedContent>("partnerLogo");

                        <div class="cxp-card">
                            <img src="@logo.Url()"
                                 alt="@logo.Name" />
                        </div>
                    }

                </div>
            </div>

        </div>

    </div>

</section>

<script>
(function () {

    var rootId = "@uid";

    function initPartners() {

        var root = document.getElementById(rootId);
        if (!root || typeof gsap === "undefined") return;

       function marquee(selector, speed, reverse, setCount) {

    var track = root.querySelector(selector);
    if (!track) return;

    // width of ONE set = total / number of repetitions
    var distance = track.scrollWidth / setCount;
    if (!distance) return;

    var tween = gsap.fromTo(track,
        { x: reverse ? -distance : 0 },
        {
            x: reverse ? 0 : -distance,
            duration: speed,
            ease: "none",
            repeat: -1
        }
    );

    var row = track.closest(".cxp-row");
    if (row) {
        row.addEventListener("mouseenter", function () { tween.pause(); });
        row.addEventListener("mouseleave", function () { tween.play(); });
    }
}

marquee(".cxp-row-one .cxp-track", 45, false, 4);
marquee(".cxp-row-two .cxp-track", 45, true, 4);
    }

    // wait for images so scrollWidth is accurate
    if (document.readyState === "complete") {
        initPartners();
    } else {
        window.addEventListener("load", initPartners);
    }

})();
</script>
