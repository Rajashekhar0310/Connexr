@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@inherits UmbracoViewPage<BlockListItem>

@{
    var content = Model.Content;

    var quote = content.Value<string>("quote");
    var author = content.Value<string>("author");
    var role = content.Value<string>("role");

    var image = content.Value<MediaWithCrops>("authorImage");

    var background = content.Value<string>("backgroundStyle") ?? "Light";
}

<section class="blog-quote @background.ToLower()">

    <div class="container">

        <div class="quote-wrapper">

            <div class="quote-icon">
                "
            </div>

            <div class="quote-content">

                @Html.Raw(quote)

                @if(!string.IsNullOrWhiteSpace(author))
                {
                    <div class="quote-author">

                        @if(image != null)
                        {
                            <img src="@image.MediaUrl()" alt="@author" />
                        }

                        <div>

                            <h4>@author</h4>

                            <span>@role</span>

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>

</section>