
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>

@{
    var smallLabel = Model.Content.Value<string>("smallLabel");
    var heading = Model.Content.Value<string>("heading");
    var description = Model.Content.Value<string>("description");
    var highlightWord = Model.Content.Value<string>("highlightWord");

    var items = Model.Content.Value<BlockListModel>("accordions");

    // Background Image (Media Picker)
    var bgImage = Model.Content.Value<MediaWithCrops>("backgroundImage");
    var bgImageUrl = bgImage?.MediaUrl();

    if (!string.IsNullOrWhiteSpace(highlightWord) &&
        !string.IsNullOrWhiteSpace(heading))
    {
        heading = heading.Replace(
            highlightWord,
            $"<span class='highlight'>{highlightWord}</span>"
        );
    }
}

<section class="faq-section">

    <div class="faq-layout">

        <!-- Left Side -->
        <div class="faq-left"
             @if (!string.IsNullOrWhiteSpace(bgImageUrl))
             {
                 <text>style="background-image:url('@bgImageUrl');"</text>
             }>

            @if (!string.IsNullOrWhiteSpace(smallLabel))
            {
                <span class="faq-label">
                    @smallLabel
                </span>
            }

            @if (!string.IsNullOrWhiteSpace(heading))
            {
                <h2>
                    @Html.Raw(heading.Replace("|", "<br/>"))
                </h2>
            }

            @if (!string.IsNullOrWhiteSpace(description))
            {
                <p>
                    @Html.Raw(description.Replace(Environment.NewLine, "<br/>"))
                </p>
            }

            <div class="faq-dots">
                <span></span>
                <span></span>
            </div>

        </div>


        <!-- Right Side -->
        <div class="faq-right">

            @if (items != null && items.Any())
            {
                int count = 1;

                foreach (var item in items)
                {
                    var question = item.Content.Value<string>("question");
                    var answer = item.Content.Value<string>("answer");

                    <details class="faq-item" @(count == 1 ? "open" : "")>

                        <summary>

                            <span class="faq-number">
                                @count.ToString("D2")
                            </span>

                            <span class="faq-question">
                                @question
                            </span>

                            <span class="faq-icon"></span>

                        </summary>

                        <div class="faq-answer">
                            @Html.Raw(answer)
                        </div>

                    </details>

                    count++;
                }
            }

        </div>

    </div>

</section>
<script>
document.addEventListener("DOMContentLoaded", function () {

    const accordions = document.querySelectorAll(".faq-item");

    accordions.forEach(function (item) {

        item.addEventListener("toggle", function () {

            if (this.open) {

                accordions.forEach(function (other) {

                    if (other !== item) {
                        other.removeAttribute("open");
                    }

                });

            }

        });

    });

});
</script>