@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    var home = Model.Root();

    var siteData = home.Children()
        .FirstOrDefault(x => x.ContentType.Alias == "siteData");

    var footer = siteData?
        .Children()
        .FirstOrDefault(x => x.ContentType.Alias == "siteFooterContent");

    if (footer == null)
    {
        return;
    }

    var logo = footer.Value<IPublishedContent>("footerLogo");
    var heading = footer.Value<string>("footerHeading");
    var cta = footer.Value<Link>("ctaButton");
    var copyright = footer.Value<string>("copyrightText");

    var navGroups = footer.Value<BlockListModel>("navigationGroups");
    var socialIcons = footer.Value<BlockListModel>("socialIcons");
}

<footer class="site-footer">

    <div class="container">

        <div class="footer-top">

            <div class="footer-left">

                @if (logo != null)
                {
                    <img src="@logo.Url()" alt="Footer Logo" class="footer-logo" />
                }

                @if (!string.IsNullOrWhiteSpace(heading))
                {
                    <h2>@heading</h2>
                }

                @if (cta != null)
                {
                    <a href="@cta.Url" class="footer-cta" target="@cta.Target">
                        @cta.Name
                    </a>
                }

            </div>

            <div class="footer-right">

                @if (navGroups != null)
                {
                    foreach (var block in navGroups)
                    {
                        var content = block.Content;

                        var title = content.Value<string>("groupTitle");
                        var links = content.Value<IEnumerable<Link>>("links");

                        <div class="footer-column">

                            <h4>@title</h4>

                            <ul>

                                @if (links != null)
                                {
                                    foreach (var link in links)
                                    {
                                        <li>
                                            <a href="@link.Url" target="@link.Target">
                                                @link.Name
                                            </a>
                                        </li>
                                    }
                                }

                            </ul>

                        </div>
                    }
                }

            </div>

        </div>

        <div class="footer-bottom">

            <div class="footer-social">

                @if (socialIcons != null)
                {
                    foreach (var block in socialIcons)
                    {
                        var content = block.Content;

                        var icon = content.Value<IPublishedContent>("socialIcon");
                        var socialUrl = content.Value<string>("socialLink");

                        <a href="@socialUrl" target="_blank">

                            @if (icon != null)
                            {
                                <img src="@icon.Url()" alt="" width="40px" height="40px" />
                            }

                        </a>
                    }
                }

            </div>

            <div class="footer-copyright">
                @copyright
            </div>

        </div>

    </div>

</footer>