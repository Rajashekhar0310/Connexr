@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "master.cshtml";   // change to your master layout
}
@*
    ============================================================================
    FAQ Page  —  single file: markup, CSS and the accordion JS
    ----------------------------------------------------------------------------
    Save as: Views/faqPage.cshtml
             (file name must match the document type alias exactly)

    Document type: faqPage
        faqTitle        Textstring     "Frequently Asked Questions" (use | for a line break)
        faqLead         Textarea       intro paragraph under the title
        faqGroups       Block List     blocks of type cnxFaqGroup
        ctaHeading      Textstring     "Still have questions?"
        ctaText         Textarea       line under the CTA heading
        ctaButtonText   Textstring     "Contact Us"
        ctaLink         Multi URL Picker (max 1)

    Element type: cnxFaqGroup
        groupTitle      Textstring (mandatory)   category heading
        groupItems      Block List   blocks of type cnxFaqItem

    Element type: cnxFaqItem
        faqQuestion     Textstring (mandatory)
        faqAnswer       Textarea     (use a blank line for a paragraph break)

    Behaviour: numbers (01, 02...) are generated from the loop, one answer open at
    a time within each category, and only the very first item on the page starts open.
    ============================================================================
*@
@{
    var faqTitle      = Model.Value<string>("faqTitle");
    var faqLead       = Model.Value<string>("faqLead");
    var faqGroups     = Model.Value<BlockListModel>("faqGroups")?.ToList() ?? new List<BlockListItem>();

    var ctaHeading    = Model.Value<string>("ctaHeading");
    var ctaText       = Model.Value<string>("ctaText");
    var ctaButtonText = Model.Value<string>("ctaButtonText");
    var ctaLink       = Model.Value<Link>("ctaLink");

    // tracks the single item that should render open across the whole page
    var firstOpenUsed = false;
}

<style>
        :root{
            --navy:#12245e;
            --orange:#f58a3c;
            --body:#5a6480;
            --cream:#FFF4EB;
            --group:#f6e9db;
            --line:#e7dccd;
          }
          *{box-sizing:border-box;margin:0;padding:0}
          body{
            font-family:'Poppins',system-ui,-apple-system,"Segoe UI",sans-serif;
            color:var(--body);background:var(--cream);
            -webkit-font-smoothing:antialiased;line-height:1.6;
          }

          .faq{position:relative;padding:64px 20px 100px;overflow:hidden}

          .faq__dots{position:absolute;display:flex;gap:9px;z-index:0}
          .faq__dots i{width:8px;height:8px;border-radius:50%;background:var(--orange);opacity:.85}
          .faq__dots--left{top:360px;left:6%}
          .faq__dots--right{top:360px;right:6%}

          .faq__inner{
            position:relative;
            z-index:1;
            max-width:820px;
            margin:0 auto;
                margin-top: 100px;
            }

          .faq__crumbs{
            font-size:10px;font-weight:600;letter-spacing:1.2px;text-transform:uppercase;
            color:var(--navy);opacity:.7;margin-bottom:34px;
          }
          .faq__crumbs a{color:inherit;text-decoration:none}
          .faq__crumbs span{margin:0 6px;opacity:.6}

          .faq__title{
            color:var(--navy);font-size:clamp(32px,4vw,46px);font-weight:700;
            line-height:1.15;letter-spacing:-.01em;margin-bottom:18px;
          }
          .faq__lead{
            color:var(--navy);font-size:16px;font-weight:500;line-height:1.6;
            max-width:52ch;margin-bottom:24px;opacity:.85;
          }
          .faq__rule{height:1px;background:var(--line);border:0;margin:0 0 40px}

          /* ---------- category ---------- */
          .faq-group{margin-bottom:34px}

          .faq-group__title{
            background:var(--group);
            color:var(--navy);
            font-size:19px;font-weight:600;
            padding:16px 24px;margin-bottom:12px;
            border-radius:2px;
          }

          /* ---------- item ---------- */
          .faq-item{
            border-bottom:1px solid var(--line);
          }
          .faq-item__head{
            width:100%;display:flex;align-items:center;gap:18px;
            padding:20px 6px;background:none;border:0;cursor:pointer;
            font:inherit;text-align:left;color:var(--navy);
          }
          .faq-item__head:focus-visible{outline:2px solid var(--orange);outline-offset:-4px}

          .faq-item__num{
            flex:none;width:22px;
            font-size:12px;font-weight:600;color:var(--navy);
          }
          .faq-item__q{
            flex:1;font-size:15px;font-weight:600;color:var(--navy);
          }
          /* circled +/- with a thin orange ring */
          .faq-item__icon{
            flex:none;width:24px;height:24px;position:relative;border-radius:50%;
            border:1.5px solid var(--orange);
            transition:background .3s ease,border-color .3s ease;
          }
          .faq-item__icon::before,
          .faq-item__icon::after{
            content:"";position:absolute;top:50%;left:50%;
            width:10px;height:1.6px;background:var(--orange);
            transform:translate(-50%,-50%);transition:transform .35s ease,opacity .35s ease,background .3s ease;
          }
          .faq-item__icon::after{transform:translate(-50%,-50%) rotate(90deg)}
          .faq-item.is-open .faq-item__icon{background:var(--orange);border-color:var(--orange)}
          .faq-item.is-open .faq-item__icon::before{background:#fff}
          .faq-item.is-open .faq-item__icon::after{opacity:0}

          .faq-item__body{
            max-height:0;overflow:hidden;
            transition:max-height .5s cubic-bezier(.22,.7,.28,1);
          }
          .faq-item__answer{
            padding:0 8px 22px 44px;
            font-size:14px;line-height:1.8;color:var(--body);max-width:64ch;
          }

          .faq-group__link{
            display:inline-flex;align-items:center;gap:8px;
            margin:16px 0 0 8px;
            color:var(--orange);font-size:13px;font-weight:600;text-decoration:none;
            transition:gap .3s ease,color .3s ease;
          }
          .faq-group__link:hover{gap:12px;color:#e97a2c}
          .faq-group__link svg{width:15px;height:15px}

          /* ---------- footer cta ---------- */
          .faq-cta{
            margin-top:14px;padding:34px 40px 40px;
            background:var(--group);border-radius:2px;
          }
          .faq-cta__title{color:var(--orange);font-size:22px;font-weight:600;margin-bottom:12px}
          .faq-cta__text{font-size:14.5px;margin-bottom:22px}
          .faq-cta__btn{
            display:inline-flex;align-items:center;gap:12px;
            padding:12px 22px;background:var(--orange);color:#fff;
            font-size:13.5px;font-weight:500;text-decoration:none;border-radius:2px;
            transition:background .3s ease,transform .3s ease;
          }
          .faq-cta__btn:hover{background:#e97a2c;transform:translateY(-1px)}
          .faq-cta__btn svg{width:16px;height:16px}

          @@media (max-width:860px){.faq__dots{display:none}}
          @@media (max-width:560px){
            .faq{padding:44px 16px 70px}
            .faq-group__title{font-size:17px;padding:14px 18px}
            .faq-item__q{font-size:14px}
            .faq-item__answer{padding-left:36px}
          }
          @@media (prefers-reduced-motion:reduce){.faq-item__body{transition:none}}
</style>

<main class="faq">
  <span class="faq__dots faq__dots--left" aria-hidden="true"><i></i><i></i></span>
  <span class="faq__dots faq__dots--right" aria-hidden="true"><i></i><i></i></span>

  <div class="faq__inner">

    @if (!string.IsNullOrWhiteSpace(faqTitle))
    {
        <h1 class="faq__title">@Html.Raw(Html.Encode(faqTitle).Replace("|", "<br />"))</h1>
    }

    @if (!string.IsNullOrWhiteSpace(faqLead))
    {
        <p class="faq__lead">@faqLead</p>
    }

    <hr class="faq__rule">

    @foreach (var groupBlock in faqGroups)
    {
        var group      = groupBlock.Content;
        var groupTitle = group.Value<string>("groupTitle");
        var items      = group.Value<BlockListModel>("groupItems")?.ToList() ?? new List<BlockListItem>();
<!-- <p style="background:yellow">DEBUG aliases = @string.Join(" | ", group.Properties.Select(p => p.Alias))</p>
<p style="background:yellow">DEBUG count = @(group.Value<BlockListModel>("groupItems")?.Count ?? -1)</p> -->
        <section class="faq-group" data-faq-group>
            <h2 class="faq-group__title">@groupTitle</h2>

            @for (var i = 0; i < items.Count; i++)
            {
                var item     = items[i].Content;
                var question = item.Value<string>("faqQuestion");
                var answer   = item.Value<string>("faqAnswer");

                var isOpen = !firstOpenUsed;
                if (isOpen) { firstOpenUsed = true; }

                <div class="faq-item@(isOpen ? " is-open" : null)">
                    <button class="faq-item__head" type="button" aria-expanded="@(isOpen ? "true" : "false")">
                        <span class="faq-item__num">@((i + 1).ToString("00"))</span>
                        <span class="faq-item__q">@question</span>
                        <span class="faq-item__icon" aria-hidden="true"></span>
                    </button>
                    <div class="faq-item__body">
                        @if (!string.IsNullOrWhiteSpace(answer))
                        {
                            foreach (var para in answer.Replace("\r\n", "\n").Split(new[] { "\n\n" }, StringSplitOptions.RemoveEmptyEntries))
                            {
                                <p class="faq-item__answer">@para.Trim()</p>
                            }
                        }
                    </div>
                </div>
            }
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(ctaHeading) || ctaLink != null)
    {
        <div class="faq-cta">
            @if (!string.IsNullOrWhiteSpace(ctaHeading))
            {
                <h2 class="faq-cta__title">@ctaHeading</h2>
            }
            @if (!string.IsNullOrWhiteSpace(ctaText))
            {
                <p class="faq-cta__text">@ctaText</p>
            }
            @if (ctaLink != null)
            {
                <a class="faq-cta__btn" href="@ctaLink.Url" target="@ctaLink.Target">
                    @(string.IsNullOrWhiteSpace(ctaButtonText) ? ctaLink.Name : ctaButtonText)
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
                </a>
            }
        </div>
    }

  </div>
</main>

<script>
        (function(){
          document.querySelectorAll('[data-faq-group]').forEach(function(group){
            var items = Array.prototype.slice.call(group.querySelectorAll('.faq-item'));
            function body(it){ return it.querySelector('.faq-item__body'); }
            function open(it){
              it.classList.add('is-open');
              it.querySelector('.faq-item__head').setAttribute('aria-expanded','true');
              body(it).style.maxHeight = body(it).scrollHeight + 'px';
            }
            function close(it){
              it.classList.remove('is-open');
              it.querySelector('.faq-item__head').setAttribute('aria-expanded','false');
              body(it).style.maxHeight = '0px';
            }
            items.forEach(function(it){
              it.querySelector('.faq-item__head').addEventListener('click', function(){
                var wasOpen = it.classList.contains('is-open');
                items.forEach(close);
                if(!wasOpen) open(it);
              });
            });
            items.forEach(function(it){ it.classList.contains('is-open') ? open(it) : close(it); });
          });
          var t;
          window.addEventListener('resize', function(){
            clearTimeout(t);
            t = setTimeout(function(){
              document.querySelectorAll('.faq-item.is-open').forEach(function(it){
                it.querySelector('.faq-item__body').style.maxHeight = it.querySelector('.faq-item__body').scrollHeight + 'px';
              });
            },120);
          });
        })();
</script>
