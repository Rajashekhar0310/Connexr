@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    Layout = "master.cshtml";

    var heroSection = Model.Value<BlockListModel>("aiopsHeroSection");
    var contentSection = Model.Value<BlockListModel>("aiopsContent");
}

@if (heroSection != null && heroSection.Any())
{
    @await Html.GetBlockListHtmlAsync(heroSection)
}

@if (contentSection != null && contentSection.Any())
{
    @await Html.GetBlockListHtmlAsync(contentSection)
}