@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent

@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    Layout = "Master.cshtml";

    var sections = Model.Value<BlockListModel>("blogSections");
}

<link rel="stylesheet" href="~/css/blogs.css" />

<div class="blog-page">

    @* Render Hero Block *@
    @{
        var hero = sections?.FirstOrDefault(x => x.Content.ContentType.Alias == "blogHeroSection");
    }

    @if (hero != null)
    {
        @await Html.PartialAsync("~/Views/Partials/BlockList/Components/blogHeroSection.cshtml", hero)
    }

    <section class="blog-wrapper">

        <div class="container">

            <div class="blog-layout">

                <!-- Left Navigation -->
                <aside class="blog-sidebar">

                    <div class="blog-toc">

                        @{
                            int index = 1;

                            foreach (var item in sections.Where(x => x.Content.ContentType.Alias == "blogContentSection"))
                            {
                                var sectionId = item.Content.Value<string>("sectionId");
                                var heading = item.Content.Value<string>("heading");

                                <a href="#@sectionId"
                                   class="toc-link"
                                   data-target="@sectionId">

                                    <span>@index.ToString("D2")</span>

                                    @heading

                                </a>;

                                index++;
                            }
                        }

                    </div>

                </aside>

                <!-- Right Content -->
                <div class="blog-content">

                   @foreach (var item in sections.Where(x => x.Content.ContentType.Alias != "blogHeroSection"))
{
    switch (item.Content.ContentType.Alias)
    {
        case "blogContentSection":
            @await Html.PartialAsync(
                "~/Views/Partials/BlockList/Components/blogContentSection.cshtml",
                item)
            break;

        case "blogBannerSection":
            @await Html.PartialAsync(
                "~/Views/Partials/BlockList/Components/blogBannerSection.cshtml",
                item)
            break;

        case "blogQuoteSection":
            @await Html.PartialAsync(
                "~/Views/Partials/BlockList/Components/blogQuoteSection.cshtml",
                item)
            break;

        case "blogVideoSection":
            @await Html.PartialAsync(
                "~/Views/Partials/BlockList/Components/blogVideoSection.cshtml",
                item)
            break;

        case "blogCalloutSection":
            @await Html.PartialAsync(
                "~/Views/Partials/BlockList/Components/blogCalloutSection.cshtml",
                item)
            break;

        case "blogCtaSection":
            @await Html.PartialAsync(
                "~/Views/Partials/BlockList/Components/blogCtaSection.cshtml",
                item)
            break;
    }
}

                </div>

            </div>

        </div>

    </section>

   @{
    var relatedBlogs = Model.Parent()?
        .ChildrenOfType("blogsPage")
        .Where(x => x.Id != Model.Id)
        .OrderByDescending(x => x.Value<DateTime>("publishDate"))
        .Take(4)
        .ToList() ?? new List<IPublishedContent>();
}

@if (relatedBlogs.Any())
{
    <section class="insight-blog-related-section">

        <div class="insight-blog-container">

            <div class="insight-blog-section-header">

                <h2>Related Insights</h2>

                <p>
                    Continue reading our latest insights and articles.
                </p>

            </div>

            <div class="insight-blog-related-grid">

                @foreach (var blog in relatedBlogs)
                {
                    var blogTitle = blog.Value<string>("blogTitle");
                    var blogDescription = blog.Value<string>("shortDescription");
                    var blogImage = blog.Value<IPublishedContent>("image");
                    var blogCategory = blog.Value<string>("category");
                    var blogDate = blog.Value<DateTime>("publishDate");
                    var blogReadingTime = blog.Value<string>("readingTime");

                    <a href="@blog.Url()"
                       class="insight-blog-related-card">

                        @if (blogImage != null)
                        {
                            <div class="insight-blog-related-image">

                                <img src="@blogImage.Url()"
                                     alt="@blogTitle" />

                            </div>
                        }

                        <div class="insight-blog-related-content">

                            @if (!string.IsNullOrWhiteSpace(blogCategory))
                            {
                                <span class="insight-blog-related-category">
                                    @blogCategory
                                </span>
                            }

                            <h3>
                                @blogTitle
                            </h3>

                            @if (!string.IsNullOrWhiteSpace(blogDescription))
                            {
                                <p>
                                    @blogDescription
                                </p>
                            }

                            <div class="insight-blog-related-meta">

                                <span>
                                    @blogDate.ToString("dd MMM yyyy")
                                </span>

                                @if (!string.IsNullOrWhiteSpace(blogReadingTime))
                                {
                                    <span>
                                        • @blogReadingTime
                                    </span>
                                }

                            </div>

                        </div>

                    </a>
                }

            </div>

        </div>

    </section>
}
</div>

<script src="~/scripts/bog-page.js"></script>