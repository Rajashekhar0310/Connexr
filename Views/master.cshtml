<script>
document.addEventListener("DOMContentLoaded", function () {

    const slider = document.querySelector(".aboutCardsSwiper");

    if (slider) {

        new Swiper(".aboutCardsSwiper", {
            slidesPerView: 2,
            spaceBetween: 24,

            navigation: {
                nextEl: ".custom-next",
                prevEl: ".custom-prev"
            },

            breakpoints: {
                0: {
                    slidesPerView: 1
                },
                992: {
                    slidesPerView: 2
                }
            }
        });

    }
});
</script>
